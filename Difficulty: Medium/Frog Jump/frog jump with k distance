class Solution {
    int[] dp;

    public int frogJump(int[] heights, int k) {
        int n = heights.length;

        dp = new int[n];
        Arrays.fill(dp, -1);

        return solve(n - 1, heights, k);
    }

    int solve(int i, int[] heights, int k) {

        // Reached the first step
        if (i == 0) {
            return 0;
        }

        // Already calculated
        if (dp[i] != -1) {
            return dp[i];
        }

        int minCost = Integer.MAX_VALUE;

        // Try all possible jumps
        for (int j = 1; j <= k; j++) {

            if (i - j >= 0) {

                int cost = solve(i - j, heights, k)
                         + Math.abs(heights[i] - heights[i - j]);

                minCost = Math.min(minCost, cost);
            }
        }

        return dp[i] = minCost;
    }
}
